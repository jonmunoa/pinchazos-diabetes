<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup (Android 12+): copia en la nube y transferencia entre dispositivos. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="pinchazos.db" />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="pinchazos.db" />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
